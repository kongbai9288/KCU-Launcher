<?xml version="1.0" encoding="utf-8"?>
<!-- 0.99.1 主界面骨架：按移动端揉纸试卷 UI 重建中央舞台。
     硬约束：activity_main.xml 的全部 R.id 不动；本文件保留 stage_card / stage_version / watermark 三个既有 id，
     MainUI.java 依赖它们。新增 id 一律 kcu_ 前缀，且每个可点控件都在 MainUI 里挂了真实反馈。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kcu_paper"
    android:orientation="vertical"
    android:paddingStart="@dimen/kcu_sp_4"
    android:paddingTop="@dimen/kcu_sp_3"
    android:paddingEnd="@dimen/kcu_sp_4"
    android:paddingBottom="@dimen/kcu_sp_2">

    <!-- 舞台视图切换：首页 / 衣柜 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/kcu_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_kcu_tab_bar"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:id="@+id/kcu_tab_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_kcu_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:text="@string/kcu_tab_home"
            android:textColor="@color/kcu_accent"
            android:textSize="13sp" />

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:id="@+id/kcu_tab_closet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_kcu_tab_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:text="@string/kcu_tab_closet"
            android:textColor="@color/kcu_ink_2"
            android:textSize="13sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <FrameLayout
        android:id="@+id/kcu_stage_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ 首页视图：空状态 / 公告卡 / 当前版本 ============ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/kcu_view_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/kcu_sp_4">

            <!-- 空状态：新用户没有实例 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/kcu_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_kcu_empty_icon" />

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:id="@+id/kcu_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/kcu_empty_title"
                    android:textColor="@color/kcu_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:id="@+id/kcu_empty_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/kcu_empty_sub"
                    android:textColor="@color/kcu_ink_3"
                    android:textSize="13sp" />

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:id="@+id/kcu_btn_go_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_kcu_button_ink"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="32dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="12dp"
                    android:singleLine="true"
                    android:text="@string/kcu_empty_go_download"
                    android:textColor="@color/kcu_paper_hi"
                    android:textSize="14sp" />

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:id="@+id/kcu_btn_skip_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:singleLine="true"
                    android:text="@string/kcu_empty_skip"
                    android:textColor="@color/kcu_ink_3"
                    android:textSize="11sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 公告卡：默认全文展开，同屏一次显示完整，不需要下滑 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/kcu_notice_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_kcu_card_flat"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/kcu_sp_6">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:id="@+id/kcu_notice_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:text="@string/kcu_notice_title"
                        android:textColor="@color/kcu_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:id="@+id/kcu_notice_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/kcu_notice_date"
                        android:textColor="@color/kcu_ink_3"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/kcu_line" />

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:id="@+id/kcu_notice_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/kcu_notice_body"
                    android:textColor="@color/kcu_ink_2"
                    android:textSize="13sp" />

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:id="@+id/kcu_notice_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:singleLine="true"
                    android:text="@string/kcu_notice_collapse_hint"
                    android:textColor="@color/kcu_accent"
                    android:textSize="11sp" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kcu_tag"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:text="@string/kcu_notice_tag_update"
                        android:textColor="@color/kcu_accent"
                        android:textSize="10sp" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_kcu_tag"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:text="@string/kcu_notice_tag_stability"
                        android:textColor="@color/kcu_accent"
                        android:textSize="10sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 当前版本卡：保留既有 id，MainUI.refreshSelectedVersion 写入这里 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/stage_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/kcu_sp_3"
                android:background="@drawable/bg_card_paper"
                android:orientation="vertical"
                android:paddingStart="@dimen/kcu_sp_4"
                android:paddingTop="@dimen/kcu_sp_3"
                android:paddingEnd="@dimen/kcu_sp_4"
                android:paddingBottom="@dimen/kcu_sp_3">

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/kcu_stage_version"
                    android:textColor="@color/kcu_ink_3"
                    android:textSize="12sp" />

                <com.kongbai.kculauncher.library.component.view.KCUTextView
                    android:id="@+id/stage_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:textColor="@color/kcu_ink"
                    android:textSize="16sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ============ 衣柜视图：4 列 × 2 行，8 格 ============ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/kcu_view_closet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/kcu_sp_4"
            android:visibility="gone">

            <com.kongbai.kculauncher.library.component.view.KCUTextView
                android:id="@+id/kcu_closet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kcu_closet_title"
                android:textColor="@color/kcu_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.kongbai.kculauncher.library.component.view.KCUTextView
                android:id="@+id/kcu_closet_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/kcu_closet_sub"
                android:textColor="@color/kcu_ink_3"
                android:textSize="12sp" />

            <com.kongbai.kculauncher.library.component.view.KCUTextView
                android:id="@+id/kcu_closet_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:singleLine="true"
                android:textColor="@color/kcu_accent"
                android:textSize="12sp" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_1" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_1"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_2" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_2"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_3" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_3"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_4" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_4"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_5" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_5"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_6" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_6"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_7" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_7"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/kcu_skin_cell_8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kcu_skin_cell"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_kcu_skin_face_8" />

                    <com.kongbai.kculauncher.library.component.view.KCUTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:singleLine="true"
                        android:text="@string/kcu_skin_8"
                        android:textColor="@color/kcu_ink_2"
                        android:textSize="11sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

    <!-- 底部水印：保留既有 id，MainUI.onCreate 写入 app_name + app_version -->
    <com.kongbai.kculauncher.library.component.view.KCUTextView
        android:id="@+id/watermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/kcu_sp_3"
        android:background="@drawable/bg_watermark"
        android:gravity="center"
        android:paddingStart="@dimen/kcu_sp_4"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/kcu_sp_4"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/kcu_ink_3"
        android:textSize="12sp" />

</androidx.appcompat.widget.LinearLayoutCompat>
