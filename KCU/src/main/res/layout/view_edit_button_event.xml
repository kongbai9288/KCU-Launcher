<?xml version="1.0" encoding="utf-8"?>
<com.kongbai.kculauncher.library.component.view.KCULinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.kongbai.kculauncher.library.component.view.KCUTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:text="@string/edit_view_event"
        app:auto_text_tint="true"
        android:singleLine="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"/>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_button_event_follow"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUSwitch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:id="@+id/pointer_follow"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_button_event_movable"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUSwitch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:id="@+id/movable"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_button_event_swipable"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUSwitch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:id="@+id/swipable"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCUTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/edit_button_event_tabs_hint"
        android:textSize="11sp"
        app:auto_text_tint="true"/>

    <com.kongbai.kculauncher.library.component.view.KCUTabLayout
        android:layout_marginTop="6dp"
        android:id="@+id/tab_layout"
        app:auto_text_tint="true"
        app:tabTextAppearance="@style/TabTextAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabUnboundedRipple="false"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/edit_button_event_press"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/edit_button_event_long_press"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/edit_button_event_click"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/edit_button_event_double_click"/>

    </com.kongbai.kculauncher.library.component.view.KCUTabLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/container"/>

</com.kongbai.kculauncher.library.component.view.KCULinearLayout>