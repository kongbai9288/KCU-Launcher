<?xml version="1.0" encoding="utf-8"?>
<com.kongbai.kculauncher.library.component.view.KCULinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.kongbai.kculauncher.library.component.view.KCUTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:text="@string/edit_view_info"
        app:auto_text_tint="true"
        android:singleLine="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"/>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_info_visibility"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUSpinner
            android:id="@+id/visibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_info_x"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUNumberSeekBar
            android:id="@+id/x_position"
            android:max="1000"
            app:suffix="%"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_info_y"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUNumberSeekBar
            android:id="@+id/y_position"
            android:max="1000"
            app:suffix="%"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_info_size_type"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUSpinner
            android:id="@+id/size_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:id="@+id/size_reference_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_info_reference"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUSpinner
            android:id="@+id/size_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_info_size"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUNumberSeekBar
            android:id="@+id/size"
            android:min="1"
            android:max="1000"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

    <com.kongbai.kculauncher.library.component.view.KCULinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_view_style"
            android:layout_gravity="center"
            app:auto_text_tint="true"
            android:singleLine="true"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kongbai.kculauncher.library.component.view.KCUTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:maxEms="10"
            android:maxLines="1"
            app:auto_text_tint="true"
            android:id="@+id/style_text"/>

        <com.kongbai.kculauncher.library.component.view.KCUButton
            android:layout_marginStart="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:auto_padding="false"
            android:padding="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_gravity="center"
            android:id="@+id/style"
            android:text="@string/menu_control_set"/>

    </com.kongbai.kculauncher.library.component.view.KCULinearLayout>

</com.kongbai.kculauncher.library.component.view.KCULinearLayout>